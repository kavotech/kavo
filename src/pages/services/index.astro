---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RevealText from '../../components/RevealText.astro';
import Button from '../../components/Button.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import RevealImage from '../../components/RevealImage.astro';
import Process from '../../components/Process.astro';
import CTA from '../../components/CTA.astro';
import { categories, servicesByCategory } from '../../data/services';
import { getProject } from '../../data/projects';

const showcase = { websites: 'kampala-diplomatic-international-school', software: 'breezyee-go', growth: 'rm-mangoes' } as const;
---
<BaseLayout
  title="Services — Websites, Software & Growth"
  description="Website design and development, e-commerce, mobile apps, dashboards, booking and school systems, SEO, Google Ads and digital strategy from Kavo Technologies."
>
  <PageHero eyebrow="Services" title="What we do" intro="We combine strategy, design and engineering to create digital products built around real business goals.">
    <nav class="svc-jump" aria-label="Service categories" data-hero-fade>
      {categories.map((c) => <a href={`#${c.key}`} class="tag svc-jump__link"><span>{c.number}</span>{c.name}</a>)}
    </nav>
  </PageHero>

  {categories.map((cat) => {
    const list = servicesByCategory(cat.key);
    const project = getProject(showcase[cat.key])!;
    const dark = cat.theme === 'theme-dark';
    return (
      <section class:list={['svc-cat', cat.theme]} id={cat.key} data-theme={dark ? 'dark' : 'light'} aria-labelledby={`cat-${cat.key}`}>
        <div class="container svc-cat__grid">
          <div class="svc-cat__side">
            <div class="svc-cat__sticky">
              <p class="eyebrow" data-reveal>{cat.number} — Discipline</p>
              <RevealText as="h2" id={`cat-${cat.key}`} class="t-h1">{cat.name}</RevealText>
              <p class="t-lead" data-reveal>{cat.summary}</p>
              <p class="t-muted" data-reveal>{cat.intro}</p>
              <div data-reveal><Button href="/contact" label={`Discuss ${cat.name.toLowerCase()}`} /></div>
            </div>
          </div>
          <div class="svc-cat__main">
            <a href={`/work/${project.slug}`} class="svc-cat__visual is-hoverable" data-cursor="View" aria-label={`Case study: ${project.name}`}>
              <RevealImage><ProjectVisual project={project} shape="wide" /></RevealImage>
              <span class="svc-cat__visual-cap">{project.name} <Arrow /></span>
            </a>
            <ul class="svc-cat__list" role="list">
              {list.map((s, i) => (
                <li data-reveal>
                  <a href={`/services/${s.slug}`} class="svc-row">
                    <span class="svc-row__num">{cat.number}.{i + 1}</span>
                    <span class="svc-row__body">
                      <span class="svc-row__name">{s.name}</span>
                      <span class="svc-row__short">{s.short}</span>
                    </span>
                    <span class="svc-row__arrow" aria-hidden="true"><Arrow /></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}

  <Process theme="theme-bone" />
  <CTA title="Not sure where to start?" label="Talk to us" eyebrow="Let’s talk" />
</BaseLayout>

<style>
  .svc-jump { display: flex; flex-wrap: wrap; gap: .5rem; }
  .svc-jump__link { gap: .5rem; padding: .6rem 1.1rem; font-size: .95rem; transition: background .3s, color .3s; }
  .svc-jump__link span { color: var(--color-muted); font-variant-numeric: tabular-nums; }
  @media (hover: hover) { .svc-jump__link:hover { background: var(--c-ink); color: var(--c-white); } }
  .svc-cat { padding-block: var(--space-2xl); }
  .svc-cat__grid { display: grid; gap: var(--space-xl); }
  .svc-cat__sticky { display: grid; gap: var(--space-md); max-width: 34rem; }
  .svc-cat__main { display: grid; gap: var(--space-lg); }
  .svc-cat__visual { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: var(--radius-lg); overflow: hidden; }
  .svc-cat__visual :global(.reveal-image) { height: 100%; }
  .svc-cat__visual-cap { position: absolute; left: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: var(--c-white); color: var(--c-ink); font-weight: 600; font-size: .9rem; }
  .svc-cat__visual-cap :global(svg) { width: 1rem; }
  .svc-cat__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .svc-cat__list li { border-bottom: 1px solid var(--color-line); }
  .svc-row { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: center; padding: clamp(1.1rem, 2vw, 1.6rem) 0; }
  .svc-row__num { font-size: .8rem; font-weight: 600; color: var(--color-muted); font-variant-numeric: tabular-nums; align-self: start; padding-top: .6em; }
  .svc-row__body { display: grid; gap: .25rem; }
  .svc-row__name { font-size: var(--fs-h4); font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; transition: transform .6s var(--ease-out); }
  .svc-row__short { color: var(--color-muted); font-size: .98rem; }
  .svc-row__arrow { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--color-line); transition: background .4s, color .4s; }
  .svc-row__arrow :global(svg) { width: 1.1rem; transform: rotate(-45deg); transition: transform .5s var(--ease-out); }
  @media (hover: hover) {
    .svc-row:hover .svc-row__name { transform: translateX(.75rem); }
    .svc-row:hover .svc-row__arrow { background: var(--color-text); color: var(--color-bg); }
    .svc-row:hover .svc-row__arrow :global(svg) { transform: rotate(0); }
  }
  @media (min-width: 1024px) {
    .svc-cat__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); align-items: start; }
    .svc-cat__sticky { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
