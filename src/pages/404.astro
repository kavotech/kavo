---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealText from '../components/RevealText.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex headerTheme="dark">
  <section class="nf theme-dark" data-theme="dark" data-hero>
    <div class="container nf__inner">
      <p class="eyebrow" data-hero-fade>Error 404</p>
      <RevealText as="h1" trigger="load" class="t-display">This page took a wrong turn.</RevealText>
      <p class="t-lead t-muted" data-hero-fade>The page you’re looking for has moved or no longer exists.</p>
      <div class="nf__actions" data-hero-fade>
        <Button href="/" label="Back to home" />
        <Button href="/work" label="See our work" variant="outline" />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 100svh; display: flex; align-items: center; padding-top: var(--header-h); }
  .nf__inner { display: grid; gap: var(--space-lg); }
  .nf__inner :global(h1) { max-width: 12ch; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: .75rem; }
</style>
