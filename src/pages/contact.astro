---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealText from '../components/RevealText.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';

const RECAPTCHA_SITE_KEY = '6LcnRtcsAAAAAJ8Sm0iJJPBS5oGn9PLNYQYIvT59';

const needs = [
  'Website', 'E-commerce', 'Mobile app', 'Web application / platform', 'Business dashboard', 'Booking system',
  'School management system', 'UI/UX design', 'SEO', 'Google Ads', 'Google Business', 'Social media', 'Digital strategy', 'Not sure yet',
];
const budgets = ['Under £1,000', '£1,000 – £3,000', '£3,000 – £7,000', '£7,000 – £15,000', '£15,000+', 'Not sure yet'];
const timelines = ['As soon as possible', 'Within 1 month', '1 – 3 months', 'Flexible'];
const referrals = ['Google Search', 'Social Media', 'Referral', 'Returning Client', 'Other'];
---
<BaseLayout title="Contact — Start a Project" description="Tell Kavo Technologies about your website, app or platform project. We reply to every enquiry within one working day.">
  <script slot="head" is:inline src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`} async defer></script>

  <section class="contact theme-light" data-theme="light" data-hero>
    <div class="container contact__grid">
      <header class="contact__head">
        <p class="eyebrow eyebrow--accent" data-hero-fade>Contact</p>
        <RevealText as="h1" trigger="load" class="t-display contact__title">Let’s make something great.</RevealText>
        <p class="t-lead t-muted contact__lede" data-hero-fade>Tell us a little about your project and we’ll come back within one working day with next steps.</p>
      </header>

      <aside class="contact__aside" data-hero-fade aria-label="Contact details">
        <div class="contact__block">
          <p class="contact__label">Email</p>
          <a class="contact__big link-line link-line--static" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="contact__block">
          <p class="contact__label">Phone</p>
          <a class="contact__big link-line link-line--static" href={site.phoneHref}>{site.phone}</a>
          <a class="arrow-link contact__wa" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Message us on WhatsApp <Arrow direction="up-right" /></a>
        </div>
        <div class="contact__block">
          <p class="contact__label">Hours</p>
          <p>{site.hours}</p>
        </div>
        <div class="contact__block">
          <p class="contact__label">Based in</p>
          <p>{site.location} · Working across the UK, Uganda and beyond</p>
        </div>
        <ul class="contact__socials" role="list">
          {site.socials.filter((s) => s.label !== 'WhatsApp').map((s) => <li><a href={s.href} class="arrow-link" target="_blank" rel="noopener noreferrer">{s.label} <Arrow direction="up-right" /></a></li>)}
        </ul>
      </aside>

      <div class="contact__form-wrap" data-hero-fade>
        <form class="kform" novalidate data-contact-form data-recaptcha-key={RECAPTCHA_SITE_KEY}>
          <input type="hidden" name="formStartedAt" />
          <div class="kform__trap" aria-hidden="true">
            <label for="websiteTrap">Leave this field empty</label>
            <input type="text" id="websiteTrap" name="websiteTrap" tabindex="-1" autocomplete="off" />
          </div>

          <fieldset class="kform__set">
            <legend class="kform__legend"><span>01</span> About you</legend>
            <div class="kform__row">
              <div class="kfield">
                <label for="name">Name <span aria-hidden="true">*</span></label>
                <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
                <p class="kfield__error" id="name-error" aria-live="polite"></p>
              </div>
              <div class="kfield">
                <label for="companyName">Company</label>
                <input id="companyName" name="companyName" type="text" autocomplete="organization" />
              </div>
            </div>
            <div class="kform__row">
              <div class="kfield">
                <label for="email">Email <span aria-hidden="true">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="email-error" />
                <p class="kfield__error" id="email-error" aria-live="polite"></p>
              </div>
              <div class="kfield">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
              </div>
            </div>
          </fieldset>

          <fieldset class="kform__set" aria-describedby="needs-error">
            <legend class="kform__legend"><span>02</span> What do you need? <span class="kform__hint">Choose all that apply *</span></legend>
            <div class="chips">
              {needs.map((n, i) => (
                <label class="chip"><input type="checkbox" name="needs" value={n} id={`need-${i}`} /><span>{n}</span></label>
              ))}
            </div>
            <p class="kfield__error" id="needs-error" aria-live="polite"></p>
          </fieldset>

          <fieldset class="kform__set" aria-describedby="budget-error">
            <legend class="kform__legend"><span>03</span> Budget range <span class="kform__hint">*</span></legend>
            <div class="chips">
              {budgets.map((b) => <label class="chip"><input type="radio" name="budget" value={b} /><span>{b}</span></label>)}
            </div>
            <p class="kfield__error" id="budget-error" aria-live="polite"></p>
          </fieldset>

          <fieldset class="kform__set" aria-describedby="timeline-error">
            <legend class="kform__legend"><span>04</span> Timeline <span class="kform__hint">*</span></legend>
            <div class="chips">
              {timelines.map((t) => <label class="chip"><input type="radio" name="timeline" value={t} /><span>{t}</span></label>)}
            </div>
            <p class="kfield__error" id="timeline-error" aria-live="polite"></p>
          </fieldset>

          <fieldset class="kform__set">
            <legend class="kform__legend"><span>05</span> Project details</legend>
            <div class="kfield">
              <label for="details">Tell us about the project <span aria-hidden="true">*</span></label>
              <textarea id="details" name="details" rows="6" required minlength="10" aria-describedby="details-error" placeholder="Goals, audience, features, links to anything you like…"></textarea>
              <p class="kfield__error" id="details-error" aria-live="polite"></p>
            </div>
            <div class="kfield kfield--select">
              <label for="referralSource">How did you hear about us?</label>
              <select id="referralSource" name="referralSource">
                <option value="">Select an option</option>
                {referrals.map((r) => <option value={r}>{r}</option>)}
              </select>
            </div>
            <label class="kcheck">
              <input type="checkbox" id="consent" name="consent" required aria-describedby="consent-error" />
              <span>I agree to be contacted by Kavo Technologies about this enquiry. *</span>
            </label>
            <p class="kfield__error" id="consent-error" aria-live="polite"></p>
          </fieldset>

          <div class="kform__submit">
            <button type="submit" class="btn btn--lg kform__btn" data-cursor="none">
              <span class="btn__label"><span data-submit-label>Start a conversation</span><span aria-hidden="true">Start a conversation</span></span>
              <span class="btn__icon" aria-hidden="true"><Arrow /><Arrow /></span>
            </button>
            <p class="kform__status" role="status" aria-live="polite" data-form-status></p>
          </div>
          <p class="kform__legal">
            This site is protected by reCAPTCHA and the Google
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and
            <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> apply.
          </p>
        </form>

        <div class="ksuccess theme-volt" data-form-success hidden tabindex="-1">
          <p class="eyebrow">Message received</p>
          <p class="t-h2 ksuccess__title" data-success-title>Thank you.</p>
          <p class="t-lead">We’ve received your enquiry and a confirmation email is on its way. We’ll be in touch within one working day.</p>
          <div class="ksuccess__actions">
            <a href="/work" class="btn"><span class="btn__label"><span>See our work</span><span aria-hidden="true">See our work</span></span><span class="btn__icon" aria-hidden="true"><Arrow /><Arrow /></span></a>
            <button type="button" class="btn btn--outline" data-form-reset><span class="btn__label"><span>Send another</span><span aria-hidden="true">Send another</span></span><span class="btn__icon" aria-hidden="true"><Arrow /><Arrow /></span></button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>

<style>
  .contact { padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 7rem)); padding-bottom: var(--space-2xl); }
  .contact__grid { display: grid; gap: var(--space-xl); }
  .contact__head { display: grid; gap: var(--space-lg); }
  .contact__title { max-width: 10ch; }
  .contact__lede { max-width: 36ch; }
  .contact__aside { display: grid; gap: 1.75rem; align-content: start; }
  .contact__label { font-size: .75rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); margin-bottom: .4rem; }
  .contact__big { font-size: var(--fs-h4); font-weight: 600; letter-spacing: -0.03em; line-height: 1.2; word-break: break-word; }
  .contact__wa { display: flex; width: max-content; margin-top: .6rem; font-size: .95rem; }
  .contact__socials { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; flex-wrap: wrap; }
  @media (min-width: 1024px) {
    .contact__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); column-gap: clamp(3rem, 6vw, 7rem); }
    .contact__head { grid-column: 1 / -1; }
    .contact__aside { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  }

  .kform { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .kform__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .kform__set { border: 0; margin: 0; padding: 0 0 clamp(2rem, 4vw, 3rem); min-width: 0; display: grid; gap: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .kform__legend { display: flex; flex-wrap: wrap; align-items: baseline; gap: .75rem; padding: 0; margin-bottom: 1.25rem; font-size: var(--fs-h4); font-weight: 600; letter-spacing: -0.035em; }
  .kform__legend > span:first-child { font-size: .8rem; letter-spacing: .06em; color: var(--color-muted); }
  .kform__hint { font-size: .85rem; font-weight: 500; letter-spacing: 0; color: var(--color-muted); }
  .kform__row { display: grid; gap: 1.25rem; }
  @media (min-width: 768px) { .kform__row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .kfield { display: grid; gap: .45rem; position: relative; }
  .kfield label { font-size: .9rem; font-weight: 600; }
  .kfield input, .kfield textarea, .kfield select {
    width: 100%; font: inherit; font-size: 1.1rem; color: var(--c-ink);
    padding: .9rem 0; border: 0; border-bottom: 1.5px solid rgba(13,13,15,.25); border-radius: 0; background: transparent;
    transition: border-color .3s;
    appearance: none;
  }
  .kfield textarea { resize: vertical; min-height: 9rem; line-height: 1.5; }
  .kfield select { background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 12px) 50%, calc(100% - 6px) 50%; background-size: 6px 6px; background-repeat: no-repeat; padding-right: 2rem; cursor: pointer; }
  .kfield input:focus, .kfield textarea:focus, .kfield select:focus { outline: none; border-bottom-color: var(--c-ink); }
  .kfield input:focus-visible, .kfield textarea:focus-visible, .kfield select:focus-visible { box-shadow: 0 2px 0 0 var(--c-ink); }
  .kfield__error { min-height: 0; font-size: .85rem; font-weight: 550; color: var(--c-error); }
  .kfield__error:empty { display: none; }
  .is-invalid input, .is-invalid textarea, input.is-invalid, textarea.is-invalid { border-bottom-color: var(--c-error) !important; }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; gap: .45rem; padding: .7rem 1.15rem; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1px var(--color-line); font-weight: 550; font-size: .98rem; transition: background .3s, color .3s, box-shadow .3s; user-select: none; }
  .chip span::before { content: ''; width: .5rem; height: .5rem; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; transition: background .3s; }
  @media (hover: hover) { .chip:hover span { box-shadow: inset 0 0 0 1px var(--c-ink); } }
  .chip input:checked + span { background: var(--c-ink); color: var(--c-white); box-shadow: none; }
  .chip input:checked + span::before { background: var(--c-volt); box-shadow: none; }
  .chip input:focus-visible + span { outline: 2px solid var(--c-ink); outline-offset: 3px; }

  .kcheck { display: flex; gap: .75rem; align-items: flex-start; font-size: .98rem; cursor: pointer; margin-top: .5rem; }
  .kcheck input { flex: none; width: 1.3rem; height: 1.3rem; margin: .1rem 0 0; accent-color: var(--c-ink); }

  .kform__submit { display: grid; gap: 1rem; justify-items: start; }
  .kform__btn[disabled] { opacity: .6; pointer-events: none; }
  .kform__status { font-weight: 550; }
  .kform__status[data-state='error'] { color: var(--c-error); }
  .kform__status[data-state='pending'] { color: var(--color-muted); }
  .kform__legal { font-size: .82rem; color: var(--color-muted); }
  .kform__legal a { text-decoration: underline; text-underline-offset: .15em; }

  .ksuccess { display: grid; gap: 1.5rem; padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-lg); }
  .ksuccess:focus { outline: none; }
  .ksuccess__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
</style>
