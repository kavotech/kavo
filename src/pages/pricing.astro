---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealText from '../components/RevealText.astro';
import Arrow from '../components/Arrow.astro';
import Button from '../components/Button.astro';
import PriceTicker from '../components/PriceTicker.astro';
import CTA from '../components/CTA.astro';
import { startingFrom, currency, websitePackages, extraPackages } from '../data/pricing';
import { site } from '../data/site';

const faqs = [
  { q: 'Are there any hidden fees?', a: 'No. The price we agree is the price you pay. Website packages include a free domain (.co.uk, .com, .uk or .org.uk).' },
  { q: 'Why are your prices so low?', a: 'We keep our team lean, reuse proven building blocks and focus on what actually moves your business forward — so you get agency-quality work without agency overheads.' },
  { q: 'What if I need something that isn’t listed?', a: 'Most of our work is quoted to fit — apps, dashboards, booking and school systems included. Tell us what you need and we’ll send a clear, fixed quote.' },
  { q: 'How do I get started?', a: 'Message us on WhatsApp or send the contact form. We’ll reply within one working day with next steps.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={`Pricing — Packages from ${currency}${startingFrom}`} description={`Affordable websites, e-commerce, design and digital marketing from Kavo Technologies. Packages from just ${currency}${startingFrom}, with a free domain and no hidden fees.`} schema={schema}>
  <section class="pr-hero theme-light" data-theme="light" data-hero>
    <div class="container pr-hero__inner">
      <p class="eyebrow eyebrow--accent" data-hero-fade>Pricing</p>
      <RevealText as="h1" trigger="load" class="t-display pr-hero__title">Big-agency quality. Small-business prices.</RevealText>
      <div class="pr-hero__foot">
        <p class="pr-from" data-hero-fade>
          <span class="pr-from__label">Packages from just</span>
          <span class="pr-from__price">{currency}<span data-countup={startingFrom}>{startingFrom}</span></span>
        </p>
        <div class="pr-hero__copy">
          <p class="t-lead" data-hero-fade>Honest, transparent pricing for websites, online stores, design and digital marketing — with a free domain on every website package and no hidden fees.</p>
          <div class="pr-hero__actions" data-hero-fade>
            <Button href={site.whatsapp} label="Chat on WhatsApp" external />
            <Button href="/contact" label="Get a quote" variant="outline" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <PriceTicker />

  <section class="theme-light section" data-theme="light" aria-labelledby="websites-title">
    <div class="container">
      <div class="pr-head">
        <RevealText as="h2" id="websites-title" class="t-h2">Website packages</RevealText>
        <p class="t-muted" data-reveal>All website packages include a free domain — no hidden fees.</p>
      </div>
      <ul class="pr-grid" role="list">
        {websitePackages.map((p) => (
          <li class:list={['pcard-price', { 'is-popular': p.popular }]} data-tilt data-reveal>
            {p.popular && <span class="pcard-price__badge">Most popular</span>}
            <h3 class="pcard-price__name">{p.name}</h3>
            <p class="pcard-price__price">{p.price}<span>{p.note}</span></p>
            <ul class="pcard-price__list" role="list">
              {p.features.map((f) => <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2" /></svg>{f}</li>)}
            </ul>
            <a href={p.cta.href} class="btn pcard-price__cta" target="_blank" rel="noopener noreferrer" data-cursor="none">
              <span class="btn__label"><span>{p.cta.label}</span><span aria-hidden="true">{p.cta.label}</span></span>
              <span class="btn__icon" aria-hidden="true"><Arrow /><Arrow /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="theme-bone section" data-theme="light" aria-labelledby="extras-title">
    <div class="container">
      <div class="pr-head">
        <RevealText as="h2" id="extras-title" class="t-h2">Design &amp; social</RevealText>
        <p class="t-muted" data-reveal>Quick wins for your brand and channels.</p>
      </div>
      <div class="pr-extras">
        {extraPackages.map((g) => (
          <div class="pr-extra" data-reveal>
            <h3 class="t-h4">{g.group}</h3>
            <dl class="pr-extra__list">
              {g.items.map((i) => <div><dt>{i.name}</dt><dd>{i.price}</dd></div>)}
            </dl>
            <a href={g.cta.href} class="arrow-link">{g.cta.label} <Arrow /></a>
          </div>
        ))}
        <div class="pr-extra pr-extra--custom theme-dark" data-reveal>
          <h3 class="t-h4">Apps, platforms &amp; systems</h3>
          <p class="t-muted">Mobile apps, dashboards, booking and school management systems are quoted to fit your exact needs.</p>
          <a href="/contact" class="arrow-link">Get a fixed quote <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="theme-light section" data-theme="light" aria-labelledby="faq-title">
    <div class="container pr-faq">
      <RevealText as="h2" id="faq-title" class="t-h2">Questions</RevealText>
      <div class="pr-faq__list">
        {faqs.map((f) => (
          <details class="pr-faq__item" data-reveal>
            <summary><span>{f.q}</span><span class="pr-faq__icon" aria-hidden="true"></span></summary>
            <p class="t-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA title="Not sure which package fits?" label="Ask us" eyebrow="Free advice" />
</BaseLayout>

<style>
  .pr-hero { padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 7rem)); padding-bottom: var(--space-xl); }
  .pr-hero__inner { display: grid; gap: var(--space-lg); }
  .pr-hero__title { max-width: 13ch; }
  .pr-hero__foot { display: grid; gap: var(--space-lg); align-items: end; margin-top: var(--space-md); }
  .pr-hero__copy { display: grid; gap: 1.5rem; max-width: 38rem; }
  .pr-hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .pr-from { display: grid; gap: .25rem; }
  .pr-from__label { font-size: var(--fs-eyebrow); font-weight: 650; letter-spacing: .09em; text-transform: uppercase; }
  .pr-from__price { font-size: clamp(5rem, 16vw, 15rem); font-weight: 650; line-height: .85; letter-spacing: -0.07em; font-variant-numeric: tabular-nums; }
  .pr-from__price { background: linear-gradient(transparent 62%, var(--c-volt) 62%, var(--c-volt) 88%, transparent 88%); width: max-content; padding-right: .05em; }
  @media (min-width: 1024px) { .pr-hero__foot { grid-template-columns: auto 1fr; column-gap: var(--space-xl); } .pr-hero__copy { justify-self: end; } }

  .pr-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: var(--space-lg); }
  .pr-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; perspective: 1200px; }
  @media (min-width: 1024px) { .pr-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; } }
  .pcard-price {
    position: relative; display: flex; flex-direction: column; gap: 1.25rem;
    padding: clamp(1.75rem, 2.6vw, 2.5rem); border-radius: var(--radius-lg);
    background: var(--c-bone); transform-style: preserve-3d;
    transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out);
  }
  .pcard-price.is-popular { background: var(--c-ink); color: var(--c-white); --color-muted: var(--c-muted-dark); --color-btn-bg: var(--c-volt); --color-btn-text: var(--c-ink); --color-btn-hover-bg: var(--c-white); --color-btn-hover-text: var(--c-ink); }
  .pcard-price__badge { align-self: flex-start; padding: .35rem .8rem; border-radius: var(--radius-pill); background: var(--c-volt); color: var(--c-ink); font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .pcard-price__name { font-size: var(--fs-h4); }
  .pcard-price__price { font-size: clamp(2.6rem, 4.5vw, 4.2rem); font-weight: 650; letter-spacing: -0.05em; line-height: 1; display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem; }
  .pcard-price__price span { font-size: .9rem; font-weight: 500; letter-spacing: 0; color: var(--color-muted); }
  .pcard-price__list { list-style: none; margin: 0; padding: 1.25rem 0 0; display: grid; gap: .65rem; border-top: 1px solid var(--color-line); flex: 1; }
  .pcard-price.is-popular .pcard-price__list { border-color: rgba(255,255,255,.16); }
  .pcard-price__list li { display: flex; align-items: center; gap: .6rem; }
  .pcard-price__list svg { width: 1.1rem; height: 1.1rem; flex: none; color: var(--c-volt-deep); }
  .pcard-price.is-popular .pcard-price__list svg { color: var(--c-volt); }
  .pcard-price__cta { align-self: flex-start; margin-top: .5rem; }
  @media (hover: hover) { .pcard-price:hover { box-shadow: 0 40px 70px -45px rgba(13,13,15,.5); } }

  .pr-extras { display: grid; gap: 1rem; }
  @media (min-width: 1024px) { .pr-extras { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pr-extra { display: flex; flex-direction: column; gap: 1.25rem; padding: clamp(1.5rem, 2.4vw, 2.25rem); border-radius: var(--radius-lg); background: var(--c-white); }
  .pr-extra--custom { background: var(--c-ink); }
  .pr-extra--custom .arrow-link { color: var(--c-volt); }
  .pr-extra__list { margin: 0; display: grid; flex: 1; }
  .pr-extra__list > div { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--color-line); }
  .pr-extra__list dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }

  .pr-faq { display: grid; gap: var(--space-lg); }
  @media (min-width: 1024px) { .pr-faq { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); } }
  .pr-faq__list { border-top: 1px solid var(--color-line); }
  .pr-faq__item { border-bottom: 1px solid var(--color-line); }
  .pr-faq__item summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.4rem 0; cursor: pointer; list-style: none; font-size: var(--fs-h4); font-weight: 600; letter-spacing: -0.03em; }
  .pr-faq__item summary::-webkit-details-marker { display: none; }
  .pr-faq__icon { position: relative; width: 1.25rem; height: 1.25rem; flex: none; }
  .pr-faq__icon::before, .pr-faq__icon::after { content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; background: currentColor; transition: transform .45s var(--ease-out); }
  .pr-faq__icon::after { transform: rotate(90deg); }
  .pr-faq__item[open] .pr-faq__icon::after { transform: rotate(0); }
  .pr-faq__item p { padding: 0 0 1.5rem; max-width: 56ch; }
</style>
