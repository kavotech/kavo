---
/** Infinite scrolling promise band. Pauses on hover; static for reduced motion. */
import KavoMark from './KavoMark.astro';
import { pricingPromises } from '../data/pricing';
interface Props { theme?: 'theme-volt' | 'theme-dark'; href?: string }
const { theme = 'theme-volt', href = '/pricing' } = Astro.props;
const items = [...pricingPromises, ...pricingPromises];
---
<a href={href} class:list={['ticker', theme]} data-theme={theme === 'theme-dark' ? 'dark' : 'light'} aria-label="See our pricing — packages from just £15" data-cursor="Prices">
  <div class="ticker__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="ticker__group" role="list">
        {items.map((t) => <li><span>{t}</span><KavoMark class="ticker__mark" /></li>)}
      </ul>
    ))}
  </div>
</a>
<style>
  .ticker { display: block; overflow: hidden; padding-block: clamp(.9rem, 1.6vw, 1.4rem); border-block: 1px solid var(--color-line); }
  .ticker__track { display: flex; width: max-content; animation: ticker 38s linear infinite; }
  .ticker__group { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker__group li { display: inline-flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); padding-right: clamp(1rem, 2vw, 2rem); font-size: clamp(1.4rem, 3vw, 2.8rem); font-weight: 650; letter-spacing: -0.04em; white-space: nowrap; }
  .ticker__mark { width: .6em; height: .6em; flex: none; transition: transform .6s var(--ease-out); }
  @media (hover: hover) {
    .ticker:hover .ticker__track { animation-play-state: paused; }
    .ticker:hover .ticker__mark { transform: rotate(-90deg); }
  }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; flex-wrap: wrap; width: auto; }
    .ticker__group + .ticker__group { display: none; }
  }
</style>
