---
import RevealText from '../RevealText.astro';
import ProjectCard from '../ProjectCard.astro';
import Button from '../Button.astro';
import { projectsBySlugs } from '../../data/projects';
const featured = projectsBySlugs(['breezyee-go', 'oasis-school-management', 'rm-mangoes']);
---
<section class="work-home theme-light section section--flush-top" data-theme="light" id="work">
  <div class="container">
    <div class="work-home__head">
      <RevealText as="h2" class="t-h2">Selected work</RevealText>
      <div data-reveal><Button href="/work" label="View all work" variant="outline" /></div>
    </div>
    <div class="work-home__grid">
      {featured.map((p, i) => <ProjectCard project={p} variant="grid" headingLevel="h3" eager={i === 0} class={i === 0 ? 'work-home__lead' : ''} />)}
    </div>
  </div>
</section>

<style>
  .work-home__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--color-line); }
  .work-home__grid { display: grid; gap: clamp(3rem, 5vw, 4rem) var(--gutter); }
  @media (min-width: 768px) {
    .work-home__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-home__grid :global(.work-home__lead) { grid-column: 1 / -1; }
    .work-home__grid :global(.work-home__lead .pcard__media) { aspect-ratio: 16 / 8; }
    .work-home__grid :global(.work-home__lead .pcard__title) { font-size: var(--fs-h3); max-width: 22ch; }
  }
</style>
