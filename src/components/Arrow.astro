---
interface Props { class?: string; direction?: 'right' | 'up-right' | 'down' | 'left' }
const { class: className, direction = 'right' } = Astro.props;
const rotate = { right: 0, 'up-right': -45, down: 90, left: 180 }[direction];
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" style={rotate ? `transform: rotate(${rotate}deg)` : undefined}>
  <path d="M3 12h17M13 5l7 7-7 7" />
</svg>
